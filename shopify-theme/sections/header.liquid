{%- liquid
  assign menu = linklists[section.settings.menu]
-%}
<header class="header" data-header>
  <div class="container header__row">
    <button type="button" class="icon-btn header__burger" data-open="#mobile-menu" aria-label="{{ 'general.menu' | t }}">
      {% render 'icon', name: 'menu' %}
    </button>

    <a class="logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 320 | image_tag: alt: shop.name, class: 'logo__img', widths: '160, 320' }}
      {%- else -%}
        <span>Gift</span><b>Yalla!</b>
      {%- endif -%}
    </a>

    <div class="header__tools">
      {%- if section.settings.corporate_label != blank -%}
        <a class="hpill hide-sm" href="{{ section.settings.corporate_url | default: '/pages/corporate' }}">
          {% render 'icon', name: 'briefcase' %}<span>{{ section.settings.corporate_label }}</span>
        </a>
      {%- endif -%}

      {%- comment -%} Currency: shows the current one, the dropdown lists only the OTHER countries/currencies. {%- endcomment -%}
      {%- if localization.available_countries.size > 1 -%}
        <details class="loc hide-sm">
          <summary class="hpill">
            <span class="hpill__code">{{ localization.country.currency.iso_code }}</span>
            {% render 'icon', name: 'chevron' %}
          </summary>
          <div class="loc__panel">
            {%- form 'localization', id: 'HeaderCountry' -%}
              {%- for country in localization.available_countries -%}
                {%- if country.iso_code != localization.country.iso_code -%}
                  <button class="loc__opt" type="submit" name="country_code" value="{{ country.iso_code }}">
                    <span>{{ country.name }}</span><span>{{ country.currency.iso_code }}</span>
                  </button>
                {%- endif -%}
              {%- endfor -%}
            {%- endform -%}
          </div>
        </details>
      {%- elsif localization.available_countries.size == 1 -%}
        <span class="hpill hide-sm" style="cursor:default"><span class="hpill__code">{{ localization.country.currency.iso_code }}</span></span>
      {%- endif -%}

      {%- comment -%} Language: the button names the OTHER language (Arabic page -> "English", English page -> "العربية"). {%- endcomment -%}
      {%- assign other_langs = localization.available_languages.size | minus: 1 -%}
      {%- if other_langs == 1 -%}
        {%- form 'localization', id: 'HeaderLanguage', class: 'hide-sm' -%}
          {%- for language in localization.available_languages -%}
            {%- if language.iso_code != localization.language.iso_code -%}
              <button class="hpill" type="submit" name="language_code" value="{{ language.iso_code }}">
                {% render 'icon', name: 'globe' %}<span lang="{{ language.iso_code }}">{{ language.endonym_name }}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        {%- endform -%}
      {%- elsif other_langs > 1 -%}
        <details class="loc hide-sm">
          <summary class="hpill">{% render 'icon', name: 'globe' %}<span>{{ localization.language.endonym_name }}</span>{% render 'icon', name: 'chevron' %}</summary>
          <div class="loc__panel">
            {%- form 'localization', id: 'HeaderLanguage' -%}
              {%- for language in localization.available_languages -%}
                {%- if language.iso_code != localization.language.iso_code -%}
                  <button class="loc__opt" type="submit" name="language_code" value="{{ language.iso_code }}"><span lang="{{ language.iso_code }}">{{ language.endonym_name }}</span></button>
                {%- endif -%}
              {%- endfor -%}
            {%- endform -%}
          </div>
        </details>
      {%- endif -%}

      <a class="hcircle" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart' | t }}">
        {% render 'icon', name: 'cart' %}<span class="badge" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a class="hcircle" href="{{ routes.account_url }}" aria-label="{{ 'general.account' | t }}">{% render 'icon', name: 'user' %}</a>
      {%- endif -%}
    </div>

    <span class="header__break" aria-hidden="true"></span>

    <label class="citypill" title="{{ 'general.deliver_to' | t }}">
      {%- if section.settings.flag_country != blank -%}
        <img class="citypill__flag" src="https://flagcdn.com/w80/{{ section.settings.flag_country | downcase | strip }}.png" width="32" height="32" alt="" loading="eager" decoding="async">
      {%- else -%}
        <span class="citypill__ico">{% render 'icon', name: 'pin' %}</span>
      {%- endif -%}
      <select data-city-pill aria-label="{{ 'general.deliver_to' | t }}">
        <option value="">{{ 'delivery.choose_city' | t }}</option>
        {%- assign city_lines = settings.delivery_cities | newline_to_br | strip_newlines | split: '<br />' -%}
        {%- for line in city_lines -%}
          {%- assign c = line | strip -%}
          {%- if c != blank -%}<option value="{{ c | escape }}">{{ c }}</option>{%- endif -%}
        {%- endfor -%}
      </select>
      <span class="citypill__caret">{% render 'icon', name: 'chevron' %}</span>
    </label>

    <form class="header__search" action="{{ routes.search_url }}" method="get" role="search">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}" aria-label="{{ 'general.search' | t }}">
      <input type="hidden" name="type" value="product">
      <button type="submit" class="search-go" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</button>
    </form>
  </div>

  {%- if menu != blank -%}
    <nav class="nav" aria-label="Main">
      <ul class="container nav__list">
        {%- for link in menu.links -%}
          <li class="nav__item{% if link.links.size > 0 %} has-mega{% endif %}">
            <a class="nav__link{% if link.active %} is-active{% endif %}" href="{{ link.url }}">
              {{ link.title }}{% if link.links.size > 0 %}{% render 'icon', name: 'chevron' %}{% endif %}
            </a>
            {%- if link.links.size > 0 -%}
              <div class="mega">
                <div class="container mega__grid">
                  {%- for child in link.links -%}
                    <div class="mega__col">
                      <a class="mega__title" href="{{ child.url }}">{{ child.title }}</a>
                      {%- for grand in child.links -%}
                        <a href="{{ grand.url }}">{{ grand.title }}</a>
                      {%- endfor -%}
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}
</header>

<div class="drawer" id="mobile-menu">
  <div class="drawer__scrim" data-close></div>
  <aside class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'general.menu' | t }}">
    <div class="drawer__head">
      <a class="logo" href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 240 | image_tag: alt: shop.name, class: 'logo__img' }}
        {%- else -%}
          <span>Gift</span><b>Yalla!</b>
        {%- endif -%}
      </a>
      <button type="button" class="drawer__x" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>

    <div class="drawer__body">
      {%- if menu != blank -%}
        <ul class="drawer__list">
          {%- for link in menu.links -%}
            <li style="--i:{{ forloop.index0 }}">
              {%- if link.links.size > 0 -%}
                <details>
                  <summary><span>{{ link.title }}</span>{% render 'icon', name: 'chevron' %}</summary>
                  <ul class="drawer__sub">
                    <li><a href="{{ link.url }}">{{ 'general.view_all' | t }}</a></li>
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a class="drawer__link" href="{{ link.url }}"><span>{{ link.title }}</span></a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="drawer__foot">
      <div class="drawer__quick">
        {%- if shop.customer_accounts_enabled -%}
          <a class="drawer__chip" href="{{ routes.account_url }}">{% render 'icon', name: 'user' %}<span>{{ 'general.account' | t }}</span></a>
        {%- endif -%}
        {%- if settings.whatsapp_number != blank -%}
          <a class="drawer__chip drawer__chip--wa" href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp' %}<span>WhatsApp</span></a>
        {%- endif -%}
      </div>
      <div class="drawer__loc">
        {%- if localization.available_languages.size > 1 -%}
          {%- form 'localization', id: 'DrawerLanguage' -%}
            {%- for language in localization.available_languages -%}
              {%- if language.iso_code != localization.language.iso_code -%}
                <button class="drawer__chip" type="submit" name="language_code" value="{{ language.iso_code }}">
                  {% render 'icon', name: 'globe' %}<span lang="{{ language.iso_code }}">{{ language.endonym_name }}</span>
                </button>
              {%- endif -%}
            {%- endfor -%}
          {%- endform -%}
        {%- endif -%}
        {%- if localization.available_countries.size > 1 -%}
          {%- form 'localization', id: 'DrawerCountry' -%}
            <label class="drawer__select">
              <span class="visually-hidden">{{ 'general.country' | t }}</span>
              <select name="country_code" onchange="this.form.submit()">
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }})</option>
                {%- endfor -%}
              </select>
            </label>
          {%- endform -%}
        {%- endif -%}
      </div>
    </div>
  </aside>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (text logo is used until you add one)" },
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    { "type": "text", "id": "flag_country", "label": "Flag in the city button (2-letter country code, empty for a pin icon)", "default": "sa" },
    { "type": "text", "id": "corporate_label", "label": "Corporate button label (empty to hide)", "default": "Corporate" },
    { "type": "url", "id": "corporate_url", "label": "Corporate button link" }
  ]
}
{% endschema %}
