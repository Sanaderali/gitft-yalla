{%- comment -%}
  Font Awesome icon (your kit is loaded in layout/theme.liquid).
  Usage: {% render 'icon', name: 'cart' %}
  Style (solid / regular / light / thin) is set in Theme settings > Brand > Icon style.
  Regular/light/thin need a Font Awesome Pro kit; a free kit only has solid + brands.
{%- endcomment -%}
{%- assign fa_style = settings.icon_style | default: 'fa-solid' -%}
{%- case name -%}
  {%- when 'search' -%}
    <i class="icon {{ fa_style }} fa-magnifying-glass" aria-hidden="true"></i>
  {%- when 'cart' -%}
    <i class="icon {{ fa_style }} fa-bag-shopping" aria-hidden="true"></i>
  {%- when 'user' -%}
    <i class="icon {{ fa_style }} fa-user" aria-hidden="true"></i>
  {%- when 'heart' -%}
    <i class="icon {{ fa_style }} fa-heart" aria-hidden="true"></i>
  {%- when 'menu' -%}
    <i class="icon {{ fa_style }} fa-bars" aria-hidden="true"></i>
  {%- when 'close' -%}
    <i class="icon {{ fa_style }} fa-xmark" aria-hidden="true"></i>
  {%- when 'chevron' -%}
    <i class="icon {{ fa_style }} fa-chevron-down" aria-hidden="true"></i>
  {%- when 'arrow-right' -%}
    <i class="icon {{ fa_style }} fa-arrow-right icon--flip" aria-hidden="true"></i>
  {%- when 'arrow-left' -%}
    <i class="icon {{ fa_style }} fa-arrow-left icon--flip" aria-hidden="true"></i>
  {%- when 'pin' -%}
    <i class="icon {{ fa_style }} fa-location-dot" aria-hidden="true"></i>
  {%- when 'globe' -%}
    <i class="icon {{ fa_style }} fa-globe" aria-hidden="true"></i>
  {%- when 'truck' -%}
    <i class="icon {{ fa_style }} fa-truck-fast" aria-hidden="true"></i>
  {%- when 'gift' -%}
    <i class="icon {{ fa_style }} fa-gift" aria-hidden="true"></i>
  {%- when 'clock' -%}
    <i class="icon {{ fa_style }} fa-clock" aria-hidden="true"></i>
  {%- when 'card' -%}
    <i class="icon {{ fa_style }} fa-credit-card" aria-hidden="true"></i>
  {%- when 'plus' -%}
    <i class="icon {{ fa_style }} fa-plus" aria-hidden="true"></i>
  {%- when 'briefcase' -%}
    <i class="icon {{ fa_style }} fa-briefcase" aria-hidden="true"></i>
  {%- when 'shield' -%}
    <i class="icon {{ fa_style }} fa-shield-halved" aria-hidden="true"></i>
  {%- when 'leaf' -%}
    <i class="icon {{ fa_style }} fa-leaf" aria-hidden="true"></i>
  {%- when 'money' -%}
    <i class="icon {{ fa_style }} fa-hand-holding-dollar" aria-hidden="true"></i>
  {%- when 'lock' -%}
    <i class="icon {{ fa_style }} fa-lock" aria-hidden="true"></i>
  {%- when 'star' -%}
    <i class="icon {{ fa_style }} fa-star" aria-hidden="true"></i>
  {%- when 'check' -%}
    <i class="icon {{ fa_style }} fa-circle-check" aria-hidden="true"></i>
  {%- when 'user-circle' -%}
    <i class="icon {{ fa_style }} fa-circle-user" aria-hidden="true"></i>
  {%- when 'whatsapp' -%}
    <i class="icon fa-brands fa-whatsapp" aria-hidden="true"></i>
  {%- when 'instagram' -%}
    <i class="icon fa-brands fa-instagram" aria-hidden="true"></i>
  {%- when 'tiktok' -%}
    <i class="icon fa-brands fa-tiktok" aria-hidden="true"></i>
  {%- when 'snapchat' -%}
    <i class="icon fa-brands fa-snapchat" aria-hidden="true"></i>
  {%- when 'facebook' -%}
    <i class="icon fa-brands fa-facebook-f" aria-hidden="true"></i>
  {%- when 'youtube' -%}
    <i class="icon fa-brands fa-youtube" aria-hidden="true"></i>
{%- endcase -%}
