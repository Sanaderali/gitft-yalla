{%- comment -%}
  Self-hosted fonts (no Google Fonts request): DM Sans for Latin, Cairo only on Arabic/RTL pages.
  The fallback face is metric-matched so text does not jump when the web font arrives.
{%- endcomment -%}
{{ 'dm-sans-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: '' }}
{%- if is_rtl -%}
  {{ 'cairo-arabic.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: '' }}
{%- endif -%}
<style>
  @font-face{font-family:"DM Sans";font-style:normal;font-weight:100 1000;font-display:swap;src:url({{ 'dm-sans-latin.woff2' | asset_url }}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
  @font-face{font-family:"Cairo";font-style:normal;font-weight:200 1000;font-display:swap;src:url({{ 'cairo-arabic.woff2' | asset_url }}) format("woff2");unicode-range:U+0600-06FF,U+0750-077F,U+0870-088E,U+0890-0891,U+0897-08E1,U+08E3-08FF,U+200C-200E,U+2010-2011,U+204F,U+2E41,U+FB50-FDFF,U+FE70-FE74,U+FE76-FEFC,U+102E0-102FB,U+10E60-10E7E,U+1EE00-1EEFF}
  @font-face{font-family:"DM Sans Fallback";src:local("Arial"),local("Helvetica Neue"),local("Roboto");size-adjust:104%;ascent-override:94%;descent-override:29%;line-gap-override:0%}
</style>
