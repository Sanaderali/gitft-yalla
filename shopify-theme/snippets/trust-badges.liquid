<ul class="trust" aria-label="{{ 'trust.secure_t' | t }}">
  <li><span class="trust__ico">{% render 'icon', name: 'leaf' %}</span><div><b>{{ 'trust.fresh_t' | t }}</b><small>{{ 'trust.fresh_s' | t }}</small></div></li>
  <li><span class="trust__ico">{% render 'icon', name: 'truck' %}</span><div><b>{{ 'trust.time_t' | t }}</b><small>{{ 'trust.time_s' | t }}</small></div></li>
  <li><span class="trust__ico">{% render 'icon', name: 'money' %}</span><div><b>{{ 'trust.cod_t' | t }}</b><small>{{ 'trust.cod_s' | t }}</small></div></li>
  <li><span class="trust__ico">{% render 'icon', name: 'lock' %}</span><div><b>{{ 'trust.secure_t' | t }}</b><small>{{ 'trust.secure_s' | t }}</small></div></li>
</ul>
